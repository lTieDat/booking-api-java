// =============================================================================
// BOOKING API - DB DESIGN
// =============================================================================
//
// Current Implemented Schema phản ánh schema hiện đang có trong codebase:
//   - JPA entities trong src/main/java
//   - Flyway migrations trong src/main/resources/db/migration
//
// Planned Design là thiết kế đề xuất cho các module chưa implement.
// Không coi các bảng planned là migration/entity hiện tại.
//
// Ghi chú:
//   - created_at / updated_at đến từ DateAudit
//   - created_by / updated_by đến từ UserDateAudit
//   - created_by / updated_by hiện là UUID không có foreign key cứng
//
// Changelog:
//   [planned receptionist] Thêm ROLE_RECEPTIONIST, receptionist_assignments,
//                          booking_status_logs cho phase vận hành khách sạn.
//   [planned payOS]        Bổ sung field cho payment link, webhook verification,
//                          transaction reference và reconciliation.
// =============================================================================


// =============================================================================
// ENUMS
// =============================================================================

Enum role_name {
  ROLE_USER
  ROLE_ADMIN
}

Enum otp_purpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

Enum discount_type {
  FIXED_AMOUNT
  PERCENTAGE
}

Enum booking_status {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REFUNDED
  NO_SHOW
}

Enum bed_type {
  DOUBLE
  SINGLE
}

Enum room_status {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  OUT_OF_SERVICE
}

Enum hotel_image_type {
  PREVIEW
  GALLERY
  THUMBNAIL
}

Enum actor_type {
  USER
  MANAGER
  SYSTEM
}

// --- Planned enums -----------------------------------------------------------

Enum payment_provider {
  PAYOS
  SEPAY
  CASH
  MANUAL_BANK_TRANSFER
}

Enum payment_status {
  INITIATED
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

Enum payment_webhook_status {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

Enum refund_status {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum inventory_hold_status {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

Enum invoice_status {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

Enum tax_apply_type {
  PERCENTAGE
  FIXED_PER_BOOKING
  PER_ROOM_PER_NIGHT
}


// =============================================================================
// CURRENT IMPLEMENTED SCHEMA
// =============================================================================

// --- Auth & User -------------------------------------------------------------

Table roles {
  id         uuid [pk]
  name       role_name [not null, unique]
}

Table users {
  id          uuid      [pk]
  name        varchar(40)  [not null]
  username    varchar(15)  [not null, unique]
  email       varchar(40)  [not null, unique]
  password    varchar(100) [not null]
  is_verified boolean   [not null, default: false]
  created_at  timestamp [not null]
  updated_at  timestamp [not null]
}

Table user_roles {
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]

  indexes {
    (user_id, role_id) [pk]
  }
}

Table managers {
  id            uuid         [pk]
  email         varchar(100) [not null, unique]
  password_hash varchar(255) [not null]
  full_name     varchar(100)
  is_active     boolean      [not null, default: true]
  created_at    timestamp    [not null]
  updated_at    timestamp    [not null]
}

Table otp_tokens {
  id         uuid        [pk]
  user_id    uuid        [not null, ref: > users.id]
  token      varchar(10) [not null]
  purpose    otp_purpose [not null]
  expires_at timestamp   [not null]
  is_used    boolean     [not null, default: false]
  created_at timestamp   [not null]
  updated_at timestamp   [not null]

  indexes {
    (user_id, purpose, is_used)
    (is_used, expires_at)
  }
}

// --- Hotel & Location --------------------------------------------------------

Table locations {
  id         uuid         [pk]
  country    varchar(100) [not null]
  city       varchar(100) [not null]
  province   varchar(100)
  district   varchar(100)
  detail     varchar(250)
  created_at timestamp    [not null]
  updated_at timestamp    [not null]
}

Table hotels {
  id          uuid         [pk]
  name        varchar(100) [not null]
  description text
  location_id uuid         [not null, ref: > locations.id]
  created_by  uuid
  updated_by  uuid
  created_at  timestamp    [not null]
  updated_at  timestamp    [not null]

  indexes {
    location_id
  }
}

Table hotel_images {
  id           uuid              [pk]
  hotel_id     uuid              [not null, ref: > hotels.id]
  url          varchar(500)      [not null]
  bucket       varchar(100)
  object_key   varchar(500)
  content_type varchar(100)
  size_bytes   bigint
  alt_text     varchar(100)      [not null]
  image_type   hotel_image_type  [not null]
  created_at   timestamp         [not null]
  updated_at   timestamp         [not null]

  indexes {
    hotel_id
  }
}

// --- Booking Config ----------------------------------------------------------

Table discounts {
  id             uuid          [pk]
  code           varchar(20)   [not null, unique]
  name           varchar(100)  [not null]
  discount_type  discount_type [not null, default: 'FIXED_AMOUNT']
  min_order_value int          [not null, default: 0]
  max_order_value int          [not null, default: 0]
  start_date     timestamp     [not null]
  end_date       timestamp     [not null]
  is_active      boolean       [not null, default: false]
  max_usage      int
  used_count     int
  created_by     uuid
  updated_by     uuid
  created_at     timestamp     [not null]
  updated_at     timestamp     [not null]
}

Table cancellation_policies {
  id          uuid         [pk]
  hotel_id    uuid         [ref: > hotels.id]
  name        varchar(100) [not null]
  description varchar(500)
  is_active   boolean      [not null, default: false]
  created_by  uuid
  updated_by  uuid
  created_at  timestamp    [not null]
  updated_at  timestamp    [not null]
}

// --- Room Catalog ------------------------------------------------------------

Table room_types {
  id             uuid         [pk]
  hotel_id       uuid         [not null, ref: > hotels.id]
  name           varchar(50)  [not null]
  code           varchar(30)  [not null]
  max_adults     int          [not null]
  max_children   int          [not null, default: 0]
  max_occupancy  int          [not null]
  bed_type       bed_type
  description    varchar(500)
  base_price     numeric(10,2)
  is_active      boolean      [not null, default: true]
  created_by     uuid
  updated_by     uuid
  created_at     timestamp    [not null]
  updated_at     timestamp    [not null]

  indexes {
    (hotel_id, code) [unique]
  }
}

Table rooms {
  id           uuid        [pk]
  room_type_id uuid        [not null, ref: > room_types.id]
  room_number  varchar(20) [not null]
  floor        int
  status       room_status
  is_active    boolean     [not null, default: true]
  created_by   uuid
  updated_by   uuid
  created_at   timestamp   [not null]
  updated_at   timestamp   [not null]

  indexes {
    (room_type_id, room_number) [unique]
  }
}

Table amenities {
  id           uuid         [pk]
  room_type_id uuid         [not null, ref: > room_types.id]
  code         varchar(50)  [not null]
  name         varchar(100) [not null]
  description  varchar(300)
  quantity     int          [not null, default: 1]
  is_active    boolean      [not null, default: true]
  created_by   uuid
  updated_by   uuid
  created_at   timestamp    [not null]
  updated_at   timestamp    [not null]

  indexes {
    (room_type_id, code) [unique]
    room_type_id
  }
}

// --- Guests & Booking --------------------------------------------------------

Table guests {
  id               uuid        [pk]
  first_name       varchar(40) [not null]
  last_name        varchar(40) [not null]
  middle_name      varchar(40)
  identify_card_no varchar(20) [not null, unique]
  phone_number     varchar(20) [not null]
  location_id      uuid        [ref: > locations.id, unique]
  created_at       timestamp   [not null]
  updated_at       timestamp   [not null]
}

Table bookings {
  id                      uuid           [pk]
  user_id                 uuid           [not null, ref: > users.id]
  guest_id                uuid           [ref: > guests.id]
  discount_id             uuid           [ref: > discounts.id]
  cancellation_policy_id  uuid           [ref: > cancellation_policies.id]
  check_in_date           date           [not null]
  check_out_date          date           [not null]
  actual_check_in_date    timestamp
  actual_check_out_date   timestamp
  total_guest             int
  total_price             numeric(10,2)
  currency                varchar(3)     [not null, default: 'VND']
  status                  booking_status [not null, default: 'PENDING']
  expired_at              timestamp
  note                    varchar(300)
  created_by              uuid
  updated_by              uuid
  created_at              timestamp      [not null]
  updated_at              timestamp      [not null]
}

Table booked_rooms {
  id                      uuid          [pk]
  booking_id              uuid          [not null, ref: > bookings.id]
  room_type_id            uuid          [not null, ref: > room_types.id]
  quantity                int           [not null]
  unit_price              numeric(10,2) [not null]
  room_type_name_snapshot varchar(50)
  room_type_code_snapshot varchar(30)
  bed_type_snapshot       varchar(50)
  max_occupancy_snapshot  int

  indexes {
    booking_id
    room_type_id
  }
}

Table booking_status_logs {
  id                uuid           [pk]
  booking_id        uuid           [not null, ref: > bookings.id]
  from_status       booking_status
  to_status         booking_status [not null]
  performed_by      uuid
  performed_by_type actor_type     [not null, default: 'SYSTEM']
  note              varchar(500)
  created_at        timestamp      [not null]
  updated_at        timestamp      [not null]

  indexes {
    booking_id
    performed_by
    (to_status, created_at)
  }
}

// --- Legacy Bootstrap Tables -------------------------------------------------
// Tồn tại trong migration V20260526090000 nhưng không dùng bởi domain model chính.

Table app_users_legacy {
  id            uuid         [pk]
  email         varchar(320) [not null, unique]
  full_name     varchar(100) [not null]
  password_hash varchar(100) [not null]
  created_at    timestamp    [not null]
}

Table auth_refresh_tokens_legacy {
  id         uuid         [pk]
  user_id    uuid         [not null, ref: > app_users_legacy.id]
  token      varchar(512) [not null, unique]
  expires_at timestamp    [not null]
  created_at timestamp    [not null]
  revoked_at timestamp

  indexes {
    user_id
    token [unique]
  }
}

Table info_messages_legacy {
  id         uuid         [pk]
  message    varchar(255) [not null]
  created_at timestamp    [not null]
}


// =============================================================================
// PLANNED DESIGN — NOT IMPLEMENTED YET
// =============================================================================
//
// Nguồn tham khảo (2026-05-28):
//   - payOS API:         https://payos.vn/docs/api/
//   - SePay Webhooks:    https://developer.sepay.vn/en/sepay-webhooks
//   - SePay guide:       https://docs.sepay.vn/tich-hop-webhooks.html
//
// Lưu ý provider:
//   - payOS  → payment link / checkout URL. Lưu: orderCode, paymentLinkId,
//              checkoutUrl, qrCode, returnUrl, cancelUrl, signature.
//   - SePay  → bank transfer / VietQR, webhook biến động ngân hàng.
//              Chống trùng bằng providerTransactionID.
//   - returnUrl chỉ dùng cho UX; trạng thái cuối cùng từ webhook / reconciliation.
//   - Secrets (checksum_key, api_key...) không lưu plain text trong DB.
// =============================================================================

// --- Role & Hotel Operations -------------------------------------------------
// Chưa implement trong code hiện tại.
//
// Khi triển khai receptionist:
//   - Thêm ROLE_RECEPTIONIST vào application enum RoleName và seed roles.
//   - User được gán receptionist phải có role ROLE_RECEPTIONIST trong user_roles.
//   - receptionist_assignments giới hạn receptionist theo hotel cụ thể.
//   - booking_status_logs đã có sẵn để audit check-in/check-out/cancel/no-show.

Table receptionist_assignments {
  id         uuid      [pk]
  user_id    uuid      [not null, ref: > users.id]
  hotel_id   uuid      [not null, ref: > hotels.id]
  is_active  boolean   [not null, default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (user_id, hotel_id) [unique]
    (hotel_id, is_active)
  }
}

// --- Payment Core ------------------------------------------------------------

Table payment_provider_accounts {
  id                  uuid             [pk]
  provider            payment_provider [not null]
  mode                varchar(10)      [not null, note: 'TEST | LIVE']
  display_name        varchar(100)     [not null]
  merchant_code       varchar(100)
  provider_channel_id varchar(100)     [note: 'payOS payment channel id/name if exposed']
  bank_bin            varchar(20)
  bank_account_number varchar(50)
  webhook_url         varchar(500)
  webhook_confirmed_at timestamp
  is_active           boolean          [not null, default: true]
  created_at          timestamp        [not null]
  updated_at          timestamp        [not null]

  indexes {
    (provider, mode, merchant_code) [unique]
  }
}

Table payments {
  id                  uuid             [pk]
  booking_id          uuid             [not null, ref: > bookings.id]
  provider_account_id uuid             [ref: > payment_provider_accounts.id]
  provider            payment_provider [not null]
  status              payment_status   [not null, default: 'INITIATED']
  provider_status     varchar(40)      [note: 'Raw status from payOS, e.g. PENDING, PAID, CANCELLED']
  amount_minor        bigint           [not null, note: 'VND in dong, no decimals']
  currency            varchar(3)       [not null, default: 'VND']
  attempt_no          int              [not null, default: 1]
  idempotency_key     varchar(100)     [not null, unique]

  // Provider references
  provider_order_code  varchar(100)    [note: 'payOS orderCode, numeric but stored as text for provider abstraction']
  provider_payment_id  varchar(150)    [note: 'payOS paymentLinkId or provider payment id']
  provider_reference   varchar(150)    [note: 'payOS webhook data.reference when paid']
  checkout_url         varchar(500)
  qr_code              text
  transfer_content     varchar(120)
  bank_account_number  varchar(50)
  return_url           varchar(500)
  cancel_url           varchar(500)

  expires_at      timestamp
  paid_at         timestamp
  cancelled_at    timestamp
  last_reconciled_at timestamp
  failure_reason  varchar(500)
  created_at      timestamp    [not null]
  updated_at      timestamp    [not null]

  indexes {
    booking_id
    (booking_id, attempt_no) [unique]
    (provider, provider_order_code)  [unique]
    (provider, provider_payment_id)  [unique]
    (provider, provider_reference)
  }
}

Table payment_transactions {
  id                      uuid             [pk]
  payment_id              uuid             [ref: > payments.id]
  provider                payment_provider [not null]
  provider_transaction_id varchar(150)     [not null, note: 'payOS data.reference']
  provider_order_code     varchar(100)
  provider_payment_id     varchar(150)
  amount_minor            bigint           [not null]
  currency                varchar(3)       [not null, default: 'VND']
  bank_gateway            varchar(80)
  bank_account_number     varchar(50)
  counter_account_bank_id varchar(50)
  counter_account_bank_name varchar(150)
  counter_account_name    varchar(150)
  counter_account_number  varchar(50)
  virtual_account_name    varchar(150)
  virtual_account_number  varchar(50)
  description             varchar(500)
  transaction_at          timestamp        [not null]
  raw_payload             jsonb            [not null]
  created_at              timestamp        [not null]

  indexes {
    (provider, provider_transaction_id) [unique]
    payment_id
  }
}

Table payment_webhook_events {
  id               uuid                   [pk]
  provider         payment_provider       [not null]
  payment_id       uuid                   [ref: > payments.id]
  provider_event_id varchar(150)          [note: 'payOS data.reference if present']
  provider_order_code varchar(100)
  provider_payment_id varchar(150)
  event_type       varchar(80)
  signature        varchar(500)
  verified_at      timestamp
  payload_hash     char(64)               [not null]
  payload          jsonb                  [not null]
  status           payment_webhook_status [not null, default: 'RECEIVED']
  received_at      timestamp              [not null]
  processed_at     timestamp
  retry_count      int                    [not null, default: 0]
  error_message    varchar(1000)

  indexes {
    (provider, provider_event_id) [unique]
    (provider, payload_hash)      [unique]
    (provider, provider_order_code)
    (provider, provider_payment_id)
    status
    payment_id
  }
}

Table refunds {
  id                 uuid          [pk]
  payment_id         uuid          [not null, ref: > payments.id]
  amount_minor       bigint        [not null]
  currency           varchar(3)    [not null, default: 'VND']
  status             refund_status [not null, default: 'REQUESTED']
  provider_refund_id varchar(150)
  reason             varchar(300)
  requested_at       timestamp     [not null]
  processed_at       timestamp
  raw_payload        jsonb
  created_at         timestamp     [not null]
  updated_at         timestamp     [not null]

  indexes {
    payment_id
    (payment_id, provider_refund_id)
  }
}

// --- Inventory & Hold --------------------------------------------------------
// Cần implement trước khi mở thanh toán thật để tránh oversell.

Table room_inventories {
  id              uuid      [pk]
  room_type_id    uuid      [not null, ref: > room_types.id]
  date            date      [not null]
  total_units     int       [not null]
  booked_units    int       [not null, default: 0]
  held_units      int       [not null, default: 0]
  available_units int       [not null]
  updated_at      timestamp [not null]

  indexes {
    (room_type_id, date) [unique]
  }
}

Table inventory_holds {
  id           uuid                   [pk]
  booking_id   uuid                   [not null, ref: > bookings.id]
  payment_id   uuid                   [ref: > payments.id]
  room_type_id uuid                   [not null, ref: > room_types.id]
  date         date                   [not null]
  quantity     int                    [not null]
  status       inventory_hold_status  [not null, default: 'ACTIVE']
  expires_at   timestamp              [not null]
  released_at  timestamp
  created_at   timestamp              [not null]
  updated_at   timestamp              [not null]

  indexes {
    (booking_id, room_type_id, date) [unique]
    (room_type_id, date, status)
    (status, expires_at)
  }
}

// --- Invoice & Tax -----------------------------------------------------------
// Payment = dòng tiền. Invoice = chứng từ / breakdown. Tax = snapshot.

Table invoices {
  id              uuid           [pk]
  booking_id      uuid           [not null, ref: > bookings.id]
  invoice_no      varchar(50)    [not null, unique]
  status          invoice_status [not null, default: 'DRAFT']
  subtotal_minor  bigint         [not null]
  discount_minor  bigint         [not null, default: 0]
  tax_minor       bigint         [not null, default: 0]
  total_minor     bigint         [not null]
  currency        varchar(3)     [not null, default: 'VND']
  issued_at       timestamp
  voided_at       timestamp
  created_at      timestamp      [not null]
  updated_at      timestamp      [not null]
}

Table invoice_lines {
  id          uuid         [pk]
  invoice_id  uuid         [not null, ref: > invoices.id]
  line_type   varchar(40)  [not null, note: 'ROOM | AMENITY | SERVICE | DISCOUNT | TAX | FEE']
  description varchar(300) [not null]
  quantity    int          [not null, default: 1]
  unit_minor  bigint       [not null]
  total_minor bigint       [not null]
  metadata    jsonb
  created_at  timestamp    [not null]

  indexes {
    invoice_id
  }
}

Table tax_configs {
  id            uuid          [pk]
  hotel_id      uuid          [ref: > hotels.id]
  name          varchar(100)  [not null]
  apply_type    tax_apply_type [not null]
  rate          numeric(8,4)
  amount_minor  bigint
  is_inclusive  boolean       [not null, default: false]
  is_active     boolean       [not null, default: true]
  created_at    timestamp     [not null]
  updated_at    timestamp     [not null]
}

Table booking_taxes {
  id             uuid           [pk]
  booking_id     uuid           [not null, ref: > bookings.id]
  tax_config_id  uuid           [ref: > tax_configs.id]
  tax_name       varchar(100)   [not null]
  apply_type     tax_apply_type [not null]
  rate           numeric(8,4)
  amount_minor   bigint         [not null]
  is_inclusive   boolean        [not null]
  created_at     timestamp      [not null]

  indexes {
    booking_id
  }
}


// =============================================================================
// CONSTRAINTS / RULES
// =============================================================================
//
// DB-level:
//   1. bookings.check_out_date > bookings.check_in_date
//   2. room_types.base_price >= 0
//   3. room_types.max_occupancy > 0
//   4. hotel_images.image_type CHECK (PREVIEW, GALLERY, THUMBNAIL)
//   5. room_types UNIQUE (hotel_id, code)
//   6. rooms UNIQUE (room_type_id, room_number)
//   7. amenities UNIQUE (room_type_id, code)
//   8. users UNIQUE username, email
//   9. roles UNIQUE name
//  10. guests UNIQUE identify_card_no
//  11. guests.location_id UNIQUE — mapping hiện tại one-to-one với locations
//  12. planned receptionist_assignments UNIQUE (user_id, hotel_id)
//  13. booking_status_logs.performed_by_type IN (USER, MANAGER, SYSTEM)
//
// App-level:
//   - Hầu hết enum enforce qua JPA enum mapping.
//   - Ngoại lệ: hotel_images.image_type có CHECK constraint ở DB.
//
// Planned payment rules:
//   - Booking.status ↔ Payment.status tách nhau hoàn toàn.
//   - idempotency_key unique theo payment attempt.
//   - (booking_id, attempt_no) unique để tạo lại link khi link cũ expired/cancelled.
//   - Không update Booking từ returnUrl phía client.
//   - payOS create link: ký request bằng checksum key theo payload chuẩn của payOS.
//   - payOS webhook: verify signature → insert PaymentWebhookEvent → xử lý idempotent → 2xx.
//   - Dùng UNIQUE(provider, provider_transaction_id) để chống duplicate transaction.
//   - Reconciliation job so sánh định kỳ để bắt webhook trễ/mất.
//   - amount_minor là BIGINT để khớp yêu cầu integer của provider (VND).
// =============================================================================
